# Hugo build output — generated by CI, never commit
public/

# Hugo cache and temp files
.hugo_build.lock
resources/_gen/

# macOS
.DS_Store

# Editor
.vscode/

# Local Codex workspace state
.codex/

# Humanize plugin cache
.humanize/

# Temporary working files
temp/

